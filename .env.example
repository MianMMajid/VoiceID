# VoiceLiveness Onboarder - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ============================================
# Required API Keys
# ============================================

# OpenAI API Key (for Whisper STT)
# Get from: https://platform.openai.com/api-keys
TF_VAR_openai_api_key=sk-proj-your-openai-key-here

# ElevenLabs API Key (for TTS and synthetic voice detection)
# Get from: https://elevenlabs.io/app/settings/api-keys
TF_VAR_elevenlabs_api_key=sk_your-elevenlabs-key-here

# ============================================
# Optional Configuration
# ============================================

# JWT Secret (auto-generated if not provided)
# TF_VAR_jwt_secret=

# CloudFront Private Key (only needed if enable_signed_urls = true)
# TF_VAR_cdn_private_key=

# CloudFront Public Key (only needed if enable_signed_urls = true)
# TF_VAR_cdn_public_key=

# ============================================
# Monitoring & Alerts
# ============================================

# Email address for CloudWatch alerts
TF_VAR_alert_email=alerts@example.com

# ============================================
# AWS Configuration
# ============================================

# AWS Region (default: us-east-1)
# TF_VAR_aws_region=us-east-1

# Environment (dev, staging, prod)
# TF_VAR_environment=dev

# ============================================
# Optional: Custom Domain Configuration
# ============================================

# Custom domain for API Gateway
# TF_VAR_custom_domain_name=

# ACM certificate ARN for custom domain
# TF_VAR_certificate_arn=

# Custom domain for CDN
# TF_VAR_cdn_custom_domain=

# ACM certificate ARN for CDN custom domain
# TF_VAR_cdn_certificate_arn=

# ============================================
# Optional: KMS Encryption
# ============================================

# KMS key ID for encryption at rest
# TF_VAR_kms_key_id=
